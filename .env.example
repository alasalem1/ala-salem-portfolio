# Copy this file to ".env" (same folder as server.js) and fill it in.
# Never share or upload the real .env file.

# Where new messages are sent
MAIL_TO=alasalem0@gmail.com

# Gmail account that sends the email (can be the same address)
SMTP_USER=alasalem0@gmail.com

# A Google "App password" (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on).
SMTP_PASS=xxxx xxxx xxxx xxxx

# Optional
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# PORT=3000
# ADMIN_TOKEN=choose-a-long-secret
